<?xml version="1.0" encoding="utf-8"?>
<!--
  Certificados del proveedor Google Fonts (com.google.android.gms).
  Con la librería ui-text-google-fonts las fuentes cargan de forma asíncrona.
  Si los certificados no coinciden, la app cae silenciosamente al sistema sans-serif.
  Para producción, regenerar con: Android Studio → res/font → New → Font resource file.
-->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </array>
    <string-array name="com_google_android_gms_fonts_certs_dev">
    </string-array>
    <string-array name="com_google_android_gms_fonts_certs_prod">
    </string-array>
</resources>
